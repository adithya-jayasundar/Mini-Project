# Project-level .gitignore for Mini-Project

# ========================================
# Python / Backend
# ========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg
wheelhouse/
.Python

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Pyenv
.python-version

# Testing
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmyp.json
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints/

# ========================================
# Node.js / Frontend
# ========================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production builds
dist/
dist-ssr/

# Vite
.vite/

# Lockfiles (commented out - uncomment if you don't want to commit them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ========================================
# Environment & Secrets
# ========================================

# Environment files
.env
.env.*
.env.local
.env.production
.env.development
!.env.example

# Secrets and keys
*.pem
*.key
*.crt
*.p12
secrets.json

# ========================================
# Database
# ========================================

*.sqlite3
*.db
*.db-journal
*.sql

# ========================================
# IDEs & Editors
# ========================================

# VS Code
.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ========================================
# OS Files
# ========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ========================================
# Logs
# ========================================

logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================================
# Project-Specific
# ========================================

# Vector stores and paper caches (backend)
backend/faiss_index/
backend/.paper_cache/
backend/.cache/
faiss_index/
.paper_cache/
.cache/

# FAISS indices and pickles
*.index
*.pkl
*.pickle
*.faiss

# Temporary directories
backend/faiss_index_*/
backend/temp/
temp/

# OneDrive / Cloud sync artifacts
~$*
~*.tmp
*.tmp

# ========================================
# Optional: Uncomment if needed
# ========================================

# Ignore all test output
test-results/
playwright-report/

# Ignore coverage reports
coverage/

# Ignore documentation builds
docs/_build/
site/

